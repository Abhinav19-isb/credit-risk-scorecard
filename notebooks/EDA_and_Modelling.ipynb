   "source": [
    "# Credit Risk Scorecard — EDA & Modelling Notebook\n",
    "\n",
    "**Author:** Abhinav Srivastav | AMPBA, ISB Hyderabad  \n",
    "**Dataset:** UCI Credit Card Default Dataset — 30,000 customers, 23 features  \n",
    "**Goal:** End-to-end credit risk analysis — EDA → Feature Engineering → WoE/IV → Dual-Model Scorecard → FICO-aligned Score  \n",
    "\n",
    "---\n",
    "| Stage | Description |\n",
    "|-------|-------------|\n",
    "| 1 | Data Loading & Schema Inspection |\n",
    "| 2 | Univariate Analysis |\n",
    "| 3 | Bivariate Analysis — Default Rate by Feature |\n",
    "| 4 | Correlation & Multicollinearity |\n",
    "| 5 | Feature Engineering |\n",
    "| 6 | Weight of Evidence (WoE) & Information Value (IV) |\n",
    "| 7 | Model Training — Logistic Regression vs Gradient Boosting |\n",
    "| 8 | Model Validation — AUC, KS, Gini, Confusion Matrix |\n",
    "| 9 | Scorecard Scaling — PDO Method (300–850) |\n",
    "| 10 | Business Insights & Recommendations |"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "md-s1",
   "metadata": {},
   "source": ["## Stage 1 — Data Loading & Schema Inspection"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "code-imports",
   "metadata": {},
   "outputs": [],
   "source": [
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy import stats\n",
    "\n",
    "from ucimlrepo import fetch_ucirepo\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import GradientBoostingClassifier\n",
    "from sklearn.model_selection import StratifiedKFold, cross_val_score, train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import (\n",
    "    roc_auc_score, roc_curve, classification_report,\n",
    "    confusion_matrix, ConfusionMatrixDisplay\n",
    ")\n",
    "\n",
    "plt.rcParams['figure.dpi'] = 110\n",
    "sns.set_theme(style='whitegrid', palette='muted')\n",
    "SEED = 42\n",
    "print('All libraries loaded.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "code-load",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load UCI dataset id=350\n",
    "dataset = fetch_ucirepo(id=350)\n",
    "X_raw = dataset.data.features\n",
    "y_raw = dataset.data.targets\n",
    "\n",
    "col_map = {\n",
    "    'X1':'LIMIT_BAL','X2':'SEX','X3':'EDUCATION','X4':'MARRIAGE','X5':'AGE',\n",
    "    'X6':'PAY_0','X7':'PAY_2','X8':'PAY_3','X9':'PAY_4','X10':'PAY_5','X11':'PAY_6',\n",
    "    'X12':'BILL_AMT1','X13':'BILL_AMT2','X14':'BILL_AMT3',\n",
    "    'X15':'BILL_AMT4','X16':'BILL_AMT5','X17':'BILL_AMT6',\n",
    "    'X18':'PAY_AMT1','X19':'PAY_AMT2','X20':'PAY_AMT3',\n",
    "    'X21':'PAY_AMT4','X22':'PAY_AMT5','X23':'PAY_AMT6'\n",
    "}\n",
    "X_raw = X_raw.rename(columns=col_map)\n",
    "df = pd.concat([X_raw, y_raw.rename(columns={'Y': 'DEFAULT'})], axis=1)\n",
    "\n",
    "# Recode undocumented EDUCATION and MARRIAGE values\n",
    "df['EDUCATION'] = df['EDUCATION'].replace({0: 4, 5: 4, 6: 4})\n",
    "df['MARRIAGE']  = df['MARRIAGE'].replace({0: 3})\n",
    "df = df.drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "print(f'Shape: {df.shape}')\n",
    "df.head(3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "code-schema",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Schema summary\n",
    "schema = pd.DataFrame({\n",
    "    'dtype':       df.dtypes,\n",
    "    'null_count':  df.isnull().sum(),\n",
    "    'null_pct':    (df.isnull().sum() / len(df) * 100).round(2),\n",
    "    'unique':      df.nunique(),\n",
    "    'min':         df.min(),\n",
    "    'max':         df.max()\n",
    "})\n",
    "schema"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "code-describe",
   "metadata": {},
   "outputs": [],
   "source": [
    "pd.set_option('display.float_format', '{:,.2f}'.format)\n",
    "df.describe().T"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "md-s2",
   "metadata": {},
   "source": ["## Stage 2 — Univariate Analysis"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "code-target",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2A: Target variable\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "counts = df['DEFAULT'].value_counts()\n",
    "colors = ['#2ecc71', '#e74c3c']\n",
    "bars = axes[0].bar(['Non-Default (0)', 'Default (1)'], counts.values,\n",
    "                   color=colors, edgecolor='black', width=0.45)\n",
    "for bar, val in zip(bars, counts.values):\n",
    "    axes[0].text(bar.get_x() + bar.get_width()/2, bar.get_height() + 150,\n",
    "                 f'{val:,}\\n({val/len(df)*100:.1f}%)', ha='center', fontsize=11, fontweight='bold')\n",
    "axes[0].set_title('Target Class Distribution', fontsize=13, fontweight='bold')\n",
    "axes[0].set_ylabel('Count')\n",
    "axes[0].set_ylim(0, counts.max() * 1.18)\n",
    "\n",
    "axes[1].pie(counts.values, labels=['Non-Default', 'Default'], colors=colors,\n",
    "            autopct='%1.1f%%', startangle=90, textprops={'fontsize': 12})\n",
    "axes[1].set_title('Default Rate: 22.1%', fontsize=13, fontweight='bold')\n",
    "\n",
    "plt.suptitle('Class Imbalance Analysis', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f'Default rate: {df[\"DEFAULT\"].mean()*100:.2f}%')\n",
    "print('Imbalance ratio 1:3.5 — will use class_weight=\"balanced\" in Logistic Regression.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "code-demographics",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2B: Demographic distributions\n",
    "fig, axes = plt.subplots(2, 3, figsize=(16, 9))\n",
    "axes = axes.flatten()\n",
    "\n",
    "# Credit Limit\n",
    "axes[0].hist(df['LIMIT_BAL']/1000, bins=40, color='#3498db', edgecolor='white', alpha=0.85)\n",
    "axes[0].set_title('Credit Limit Distribution', fontweight='bold')\n",
    "axes[0].set_xlabel('Credit Limit (NT$ thousands)')\n",
    "axes[0].set_ylabel('Frequency')\n",
    "axes[0].axvline(df['LIMIT_BAL'].median()/1000, color='red', linestyle='--', label=f'Median: {df[\"LIMIT_BAL\"].median()/1000:.0f}k')\n",
    "axes[0].legend()\n",
    "\n",
    "# Age\n",
    "axes[1].hist(df['AGE'], bins=35, color='#9b59b6', edgecolor='white', alpha=0.85)\n",
    "axes[1].axvline(df['AGE'].median(), color='red', linestyle='--', label=f'Median: {df[\"AGE\"].median():.0f}')\n",
    "axes[1].set_title('Age Distribution', fontweight='bold')\n",
    "axes[1].set_xlabel('Age')\n",
    "axes[1].legend()\n",
    "\n",
    "# Sex\n",
    "sex_map = {1: 'Male', 2: 'Female'}\n",
    "sex_counts = df['SEX'].map(sex_map).value_counts()\n",
    "axes[2].bar(sex_counts.index, sex_counts.values, color=['#3498db','#e91e8c'], edgecolor='black', width=0.4)\n",
    "axes[2].set_title('Gender Distribution', fontweight='bold')\n",
    "for i, v in enumerate(sex_counts.values):\n",
    "    axes[2].text(i, v+100, f'{v:,}', ha='center', fontweight='bold')\n",
    "\n",
    "# Education\n",
    "edu_map = {1:'Graduate', 2:'University', 3:'High School', 4:'Others'}\n",
    "edu_counts = df['EDUCATION'].map(edu_map).value_counts()\n",
    "axes[3].bar(edu_counts.index, edu_counts.values, color='#1abc9c', edgecolor='black')\n",
    "axes[3].set_title('Education Level', fontweight='bold')\n",
    "plt.setp(axes[3].xaxis.get_majorticklabels(), rotation=20, ha='right')\n",
    "\n",
    "# Marriage\n",
    "mar_map = {1:'Married', 2:'Single', 3:'Others'}\n",
    "mar_counts = df['MARRIAGE'].map(mar_map).value_counts()\n",
    "axes[4].bar(mar_counts.index, mar_counts.values, color='#e67e22', edgecolor='black')\n",
    "axes[4].set_title('Marital Status', fontweight='bold')\n",
    "\n",
    "# PAY_0 distribution\n",
    "pay_counts = df['PAY_0'].value_counts().sort_index()\n",
    "axes[5].bar(pay_counts.index.astype(str), pay_counts.values, color='#e74c3c', edgecolor='black')\n",
    "axes[5].set_title('Payment Status — Most Recent Month (PAY_0)', fontweight='bold')\n",
    "axes[5].set_xlabel('-2/-1=Pay Duly, 0=Min Paid, 1-9=Months Delayed')\n",
    "plt.setp(axes[5].xaxis.get_majorticklabels(), rotation=45, ha='right')\n",
    "\n",
    "plt.suptitle('Demographic Distributions', fontsize=14, fontweight='bold', y=1.01)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
